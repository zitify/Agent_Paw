# === ContextBuilder 표준 .gitignore (SSOT: Security/적용/git_민감파일관리.md v1.1.0) ===

# ContextBuilder 민감 파일
CLAUDE.md
CLAUDE.local.md
AGENTS.md
AGENTS.local.md
ARCHITECTURE.md
.claude/

# 환경 변수·시크릿
.env
.env.*
!.env.example
!.env.template

# 인증·키 (절대 git 추적 금지)
*.key
*.pem
*.p12
*.pfx
*.cert
*.crt
credentials.json
service-account*.json
firebase-service-account*.json
*-firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# ContextBuilder 중앙 Secrets 폴더 (소비 측에 만들지 않음, 만든 경우 제외)
Secrets/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

